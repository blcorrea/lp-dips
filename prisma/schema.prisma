generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
  CANCELLED
}

enum AffiliateType {
  INFLUENCER
  MEDIA_BUYER
  PARTNER
  ORGANIC
  OTHER
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Order
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id String @id @default(cuid())

  /// Human-readable identifier shown to customers, e.g. DIPS-20260324-X4K2P1
  orderNumber String @unique

  // ── Stripe ──────────────────────────────────────────────────────────────────
  stripeSessionId       String  @unique
  stripePaymentIntentId String?

  // ── Customer ────────────────────────────────────────────────────────────────
  customerEmail String
  customerName  String?

  // ── Financials ─────────────────────────────────────────────────────────────
  // All monetary values are stored in the smallest currency unit (cents).
  subtotal     Int
  shippingCost Int    @default(0)
  tax          Int    @default(0)
  discount     Int    @default(0)
  total        Int
  currency     String @default("usd")

  // ── Status ──────────────────────────────────────────────────────────────────
  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  // ── Shipping address — explicit columns, no JSON blobs ──────────────────────
  shippingName         String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?

  // ── Logistics ───────────────────────────────────────────────────────────────
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippedAt         DateTime?
  estimatedDelivery DateTime?

  // ── Notes ───────────────────────────────────────────────────────────────────
  notes         String?
  internalNotes String?

  // ── Transactional email guards — set after a successful send to prevent duplicates ──
  confirmationEmailSentAt DateTime?
  shippedEmailSentAt      DateTime?

  // ── Shopify metadata snapshot (captured at checkout time) ───────────────────
  shopifyProductId String?
  shopifyVariantId String?
  shopifyHandle    String?

  // ── Influencer / UTM attribution snapshot (captured at checkout time) ───────
  influencerRef String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  landingPage   String?

  // ── Relations ───────────────────────────────────────────────────────────────
  items      OrderItem[]
  commission Commission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([stripePaymentIntentId])
  @@index([createdAt])
  @@index([influencerRef])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrderItem
// ─────────────────────────────────────────────────────────────────────────────

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productName String
  variantName String?
  sku         String?
  imageUrl    String?

  /// Number of units purchased
  quantity Int
  /// Unit price in cents
  unitPrice Int
  /// quantity × unitPrice in cents
  subtotal Int

  // Shopify snapshot at time of purchase
  shopifyProductId String?
  shopifyVariantId String?

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Affiliate — referral partners (influencers, media buyers, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model Affiliate {
  id        String        @id @default(cuid())
  name      String
  /// Referral code stamped onto Order.influencerRef (e.g. "ana"). Lowercased
  /// by convention; uniqueness is enforced.
  ref       String        @unique
  /// Unique when present (self-signup always stores a lowercased email).
  /// NULL is allowed for admin-created affiliates without an email — Postgres
  /// permits multiple NULLs under a UNIQUE index.
  email     String?       @unique
  instagram String?
  type      AffiliateType @default(INFLUENCER)
  /// Default commission share (e.g. 0.15 = 15%). Snapshot is copied to each
  /// Commission row so historical payouts are unaffected by future changes.
  commissionRate Decimal  @default(0.15)
  active    Boolean       @default(true)

  commissions  Commission[]
  loginTokens  AffiliateLoginToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// AffiliateLoginToken — one-time magic link tokens (15-min TTL)
// ─────────────────────────────────────────────────────────────────────────────

model AffiliateLoginToken {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// 64-char hex string (32 random bytes). Globally unique.
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([token])
  @@index([affiliateId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commission — payable record per Order, snapshotted at order time
// ─────────────────────────────────────────────────────────────────────────────

model Commission {
  id          String           @id @default(cuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id])
  affiliateId String
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id])

  /// Order total at time of creation, in cents.
  grossAmount Int
  /// Commissionable base (subtotal − discount, never negative), in cents.
  baseAmount  Int
  /// Snapshot of affiliate.commissionRate at creation time.
  rate        Decimal
  /// round(baseAmount × rate), in cents.
  amount      Int

  status      CommissionStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// StripeEvent — idempotency log
// ─────────────────────────────────────────────────────────────────────────────

model StripeEvent {
  /// Stripe event id (evt_…) — used as primary key for natural uniqueness
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// AdminUser — multi-user admin authentication
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}
