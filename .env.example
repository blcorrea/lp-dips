# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the project.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Neon (recommended for Vercel deploys):
#   postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/dips_db?sslmode=require
# Supabase:
#   postgresql://postgres:password@db.XXXX.supabase.co:5432/postgres
# Local (Docker / Postgres.app):


# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SHIPPING_RATE_ID=          # Stripe shipping rate ID (shr_...)

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="shpat_..."
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_PRODUCT_HANDLE="dips-chocolate"

# ── Prisma ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:password@ep-wild-firefly-anpjgrab-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Chave de sessão — assina os JWTs de login do painel admin. Use qualquer
# string longa e aleatória. Trocar este valor invalida todas as sessões ativas
# (todos precisam logar de novo).
SESSION_SECRET="SUA_SESSION_SECRET_REAL"

# Senha-mestra de bootstrap — serve APENAS para criar o primeiro super-admin.
# No PRIMEIRO acesso, faça login em /admin/login com seu email + este valor
# como senha: isso cria o primeiro super-admin. Depois que existir 1 usuário,
# a chave-mestra para de funcionar. Se estiver vazia/ausente, o bootstrap fica
# desabilitado (o login normal com email + senha continua funcionando).
# Recomendado: REMOVER esta variável do ambiente depois do primeiro login.
ADMIN_BOOTSTRAP_KEY="SUA_CHAVE_DE_BOOTSTRAP"

# Legado: ADMIN_SECRET ainda é aceito como fallback de SESSION_SECRET (para
# deploys antigos). Prefira definir SESSION_SECRET e remover ADMIN_SECRET.
# ADMIN_SECRET=

# ── SMTP (Zoho Mail ou similar) ───────────────────────────────────────────
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="orders@dipschocolate.com"
SMTP_PASS="sua_senha_smtp"
SMTP_FROM_EMAIL="orders@dipschocolate.com"
SMTP_FROM_NAME="Dips Chocolate"

# ── Analytics & Tracking ─────────────────────────────────────────────────
# Deixe em branco enquanto não tiver os IDs — o site funciona normalmente sem eles.

# Meta Pixel (Facebook / Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=""

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=""

# Google Ads — conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=""       # ex: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LABEL=""    # ex: AbCdEfGhIjKlMnOp

# ── Google Sheets — operational warehouse mirror ──────────────────────────────
# Service Account credentials (create at console.cloud.google.com → IAM → Service Accounts)
# Share the target spreadsheet with the service account email (Editor role).
GOOGLE_SHEETS_SPREADSHEET_ID=""    # ID from the spreadsheet URL
GOOGLE_SHEETS_CLIENT_EMAIL=""      # e.g. dips-sheets@my-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=""       # Full PEM key — paste with literal \n between lines
GOOGLE_SHEETS_SHEET_NAME="Orders"  # Tab name inside the spreadsheet (default: Orders)

# ── Warehouse / Logistics notifications ───────────────────────────────────────
# Inbox that receives an internal notification every time a paid order is created.
# Leave WAREHOUSE_NOTIFICATION_EMAIL empty to disable the notification entirely.
# WAREHOUSE_SHEET_URL is optional — if set, the notification includes a link to it.
WAREHOUSE_NOTIFICATION_EMAIL=
WAREHOUSE_SHEET_URL=
